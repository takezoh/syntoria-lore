# Local-only bind addresses. Set each host to 0.0.0.0 when deploying on Cloud Run.
API_HOST=127.0.0.1
API_PORT=8080
WORKER_HOST=127.0.0.1
WORKER_PORT=8081

# Product/runtime names are configured separately in infra/local/deployment.env.
PRODUCT_DISPLAY_NAME=Syntoria Lore
DB_ROLE_SOURCE_PREFIX=thymesis
PORTABILITY_SIGNER_ID=memory-local

# Use memory_app (NOSUPERUSER NOBYPASSRLS) as the runtime database user.
DATABASE_URL=postgresql://memory_app:replace-with-local-password@127.0.0.1:55432/memory_service_test
MIGRATION_DATABASE_URL=postgresql://memory_admin:replace-with-local-password@127.0.0.1:55432/memory_service_test
APP_DB_PASSWORD=replace-with-at-least-24-characters
AUTH_ISSUER=http://127.0.0.1:9090/
AUTH_AUDIENCE=memory-service-local
AUTH_JWKS_URL=http://127.0.0.1:9090/.well-known/jwks.json
# MCP tokens are verified against these independent JWT audiences.
AUTH_MCP_READ_AUDIENCE=memory-service-local:mcp:read
AUTH_MCP_WRITE_AUDIENCE=memory-service-local:mcp:write
MCP_BASE_URL=http://127.0.0.1:8080
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Optional exact HTTP Origin allowlist for browser based MCP clients.
MCP_ALLOWED_ORIGINS=
# The local worker must share these durable governance/export locations with the API.
DELETION_LEDGER_DIR=./var/deletion-ledger
FORGET_HMAC_KEY=replace-with-a-random-secret-of-at-least-32-bytes
PORTABILITY_STORAGE_DIR=./var/portable-exports
PORTABILITY_MASTER_KEY=replace-with-a-random-secret-of-at-least-32-bytes
# Supply a random key of at least 32 bytes, base64url encoded. Keep retired keys here during rotation.
CURSOR_HMAC_ACTIVE_KEY=local-1
CURSOR_HMAC_KEYS=local-1=replace-with-base64url-encoded-32-byte-key
