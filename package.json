{
  "name": "memory-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "typecheck": "tsc --build tsconfig.json --pretty false && tsc --noEmit --pretty false --project tsconfig.test.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"package.json\" \"tsconfig*.json\" \"apps/**/*.json\" \"apps/**/*.ts\" \"packages/**/*.json\" \"packages/**/*.ts\" \"scripts/**/*.mjs\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"docs/api/**/*.json\" \"eslint.config.mjs\" \"vitest.config.ts\" \".prettierrc.json\" \"!packages/auth/src/connection-verifier.ts\"",
    "format:write": "prettier --write \"package.json\" \"tsconfig*.json\" \"apps/**/*.json\" \"apps/**/*.ts\" \"packages/**/*.json\" \"packages/**/*.ts\" \"scripts/**/*.mjs\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"docs/api/**/*.json\" \"eslint.config.mjs\" \"vitest.config.ts\" \".prettierrc.json\" \"!packages/auth/src/connection-verifier.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/core.postgres.test.ts",
    "test:integration": "node scripts/require-postgres-test-env.mjs && vitest run tests/core.postgres.test.ts && node --import tsx scripts/test-governance-restore-clone.ts && node --import tsx scripts/test-portability-fresh-db.ts && node --import tsx scripts/test-user-identity-migration.ts && node --import tsx scripts/test-subject-admission-migration.ts",
    "dev:api": "npm run dev --workspace @memory/api",
    "dev:worker": "npm run dev --workspace @memory/worker",
    "start:api": "npm run start --workspace @memory/api",
    "start:worker": "npm run start --workspace @memory/worker",
    "db:migrate": "npm run migrate --workspace @memory/db",
    "db:setup-role": "npm run setup-role --workspace @memory/db",
    "cloud:storage:bootstrap": "node scripts/cloud-ledger-bootstrap.mjs",
    "cloud:ledger:reconcile": "node scripts/cloud-ledger-reconcile.mjs",
    "cloud:verify-boundaries": "node scripts/verify-cloud-boundaries.mjs",
    "cloud:storage:smoke": "node scripts/cloud-storage-smoke.mjs",
    "cloud:restore:smoke": "node --import tsx scripts/cloud-restore-clone-smoke.ts",
    "cloud:neon:migrate": "node scripts/cloud-neon-migrate.mjs",
    "cloud:manifests": "node scripts/render-cloud-manifests.mjs",
    "cloud:build-context": "node scripts/prepare-cloud-build-context.mjs",
    "gate:identity:map": "node scripts/gate-identity-map.mjs",
    "gate:integration": "node scripts/testing/verify-gate-integration.mjs",
    "cloud:governance:smoke": "node scripts/cloud-governance-smoke.mjs",
    "openapi:export": "node --import tsx scripts/export-openapi.ts",
    "openapi:check": "node --import tsx scripts/export-openapi.ts --check",
    "secret:scan": "node scripts/secret-scan.mjs",
    "local:env": "node scripts/local-env.mjs",
    "local:reconcile": "node scripts/reconcile-restore.mjs",
    "local:diagnostics": "node scripts/local-diagnostics.mjs",
    "eval:local": "node scripts/eval-local.mjs",
    "load:local": "node scripts/load-local.mjs",
    "verify:local": "npm run build && npm run db:migrate && npm run db:migrate && npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run test:integration && npm run openapi:check && npm run secret:scan && npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "google-auth-library": "11.3.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
