{
  "name": "memory-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "typecheck": "tsc --build tsconfig.json --pretty false && tsc --noEmit --pretty false --project tsconfig.test.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"package.json\" \"tsconfig*.json\" \"apps/**/*.json\" \"apps/**/*.ts\" \"packages/**/*.json\" \"packages/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"eslint.config.mjs\" \"vitest.config.ts\" \".prettierrc.json\"",
    "format:write": "prettier --write \"package.json\" \"tsconfig*.json\" \"apps/**/*.json\" \"apps/**/*.ts\" \"packages/**/*.json\" \"packages/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"eslint.config.mjs\" \"vitest.config.ts\" \".prettierrc.json\"",
    "start:api": "npm run start --workspace @memory/api",
    "admit:subject": "node scripts/admit-subject.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:firestore": "node scripts/require-firestore-emulator.mjs && VITEST_FIRESTORE=1 vitest run tests/*.firestore.test.ts",
    "secret:scan": "node scripts/secret-scan.mjs",
    "verify:local": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run test:firestore && npm run secret:scan && npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
