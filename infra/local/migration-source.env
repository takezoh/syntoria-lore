# Explicit override for the disposable copy of the pre-rename local cluster.
COMPOSE_PROJECT_NAME=lore-local
DATABASE_NAME=thymesis
TEST_DATABASE_NAME=thymesis_test
DB_ADMIN_ROLE=thymesis_admin
DB_APP_ROLE=thymesis_app
DB_WORKER_ROLE=thymesis_worker
DB_WORKER_LOGIN_ROLE=thymesis_worker_login
LOCAL_DB_VOLUME=lore_local_db
LOCAL_ARTIFACTS_VOLUME=lore_local_artifacts
LOCAL_ISSUER_VOLUME=lore_local_issuer
